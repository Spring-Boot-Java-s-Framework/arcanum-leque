# arcanum-leque · docker/.env  (copie para docker/.env — git-ignored)
#
# Só portas do HOST. Ajuste se algo já usa essas portas na sua máquina.
# O compose funciona sem este arquivo — estes são os defaults.

WEB_PORT=8080         # web  · API
WEB_DEBUG_PORT=5005   # web  · debugger remoto (JDWP)
APP_PORT=8081         # app  · API
TEST_PORT=8082        # test · API (o serviço sobe, roda os testes e sai)
PROD_PORT=8090        # prod · API (imagem mínima + healthcheck)

# Sem banco: persistência é lista em memória (decisão do time).
